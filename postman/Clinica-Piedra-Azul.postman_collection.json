    {
      "name": "Rutas de paciente",
      "item": [
        {
          "name": "Consultar mis citas",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/appointments/my",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{patientToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Paciente consulta citas propias',()=>pm.response.to.have.status(200));",
                  "pm.test('Incluye solamente el perfil de prueba Sofía Ramírez',()=>pm.response.json().forEach(a=>pm.expect(a.patientName).to.eql('Sofía Ramírez')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Intento de filtrar por otro paciente",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/appointments/my?patientId=2",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{patientToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('El parámetro de paciente no cambia la identidad del token',()=>pm.response.to.have.status(200));",
                  "pm.test('Todas las citas siguen perteneciendo a Sofía Ramírez',()=>pm.response.json().forEach(a=>pm.expect(a.patientName).to.eql('Sofía Ramírez')));"
                ]
              }
            }
          ]
        }
      ]
