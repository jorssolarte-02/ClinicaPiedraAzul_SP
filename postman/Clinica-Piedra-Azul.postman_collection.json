{
  "info": {
    "name": "Clínica Piedra Azul API",
    "description": "Pruebas de autenticación, servicios públicos, permisos por rol y aislamiento de citas.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "Login administrador",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@piedraazul.test\",\n  \"password\": \"Admin123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login admin responde 200',()=>pm.response.to.have.status(200));",
                  "const body=pm.response.json();",
                  "pm.environment.set('adminToken',body.token);",
                  "pm.test('El token pertenece a ADMIN',()=>pm.expect(body.role).to.eql('ADMIN'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login paciente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"paciente@piedraazul.test\",\n  \"password\": \"Paciente123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login paciente responde 200',()=>pm.response.to.have.status(200));",
                  "const body=pm.response.json();",
                  "pm.environment.set('patientToken',body.token);",
                  "pm.test('El token pertenece a PATIENT',()=>pm.expect(body.role).to.eql('PATIENT'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login inválido",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@piedraazul.test\",\n  \"password\": \"incorrecta\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Credenciales incorrectas responden 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Rutas públicas",
      "item": [
        {
          "name": "Médicos públicos",
          "request": {
            "method": "GET",
            "header": [],
