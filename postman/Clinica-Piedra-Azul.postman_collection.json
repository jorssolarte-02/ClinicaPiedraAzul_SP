          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Médicos públicos sin token responden 200',()=>pm.response.to.have.status(200));",
                  "pm.test('La respuesta es una lista',()=>pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Pacientes públicos anonimizados",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/patients/public"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Listado público responde 200',()=>pm.response.to.have.status(200));",
                  "pm.test('No expone cédulas ni correos',()=>pm.response.json().forEach(p=>{pm.expect(p).not.to.have.property('cedula');pm.expect(p).not.to.have.property('email')}));"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar existencia de cédula",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/patients/exists/1020304050"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Verificación pública responde 200',()=>pm.response.to.have.status(200));",
                  "pm.test('Solo devuelve un booleano exists',()=>pm.expect(pm.response.json()).to.have.property('exists').that.is.a('boolean'));"
                ]
              }
            }
          ]
        }
      ]
    },
